# ~/.dotfiles/managers.toml
# Package manager configuration for dotfiles TUI.
#
# Each [[managers]] entry defines a logical package manager group.
#
# id              : the key used in pack.toml, e.g. "system", "python", "node".
#                   Multiple entries sharing the same id form a fallback chain —
#                   the first whose binary is found on $PATH wins. This lets you
#                   swap the active manager (e.g. uv → pipx) without touching
#                   any pack.toml files.
# try             : binaries to check in order. First found on $PATH is used
#                   as the install/uninstall binary. Also the pack.toml key
#                   fallback chain: if a package has no key matching the found
#                   binary, the remaining names in the list are tried.
# install/uninstall: args passed to the detected binary; {pkg} expands to one
#                   or more space-separated package names.
# check (optional): shell command to test if a package is installed (exit 0 =
#                   installed). {pkg} = package name. Pipes and shell syntax
#                   are supported.
# info (optional) : shell command to display package details in the TUI.
#                   {pkg} = package name. Tries local data first, falls back
#                   to a network query if not found. Pipes and shell syntax
#                   are supported.
# list (optional) : shell command that prints all installed packages, one name
#                   per line. {try} expands to the detected binary. Used by the
#                   package screen to find untracked installed packages.
#
# To disable a manager, comment out its [[managers]] block.
# To add a new manager, append a [[managers]] block and use its id as a key
# in your pack.toml [[packages]] entries.

# ── System ────────────────────────────────────────────────────────────────────

[[managers]]
id        = "system"
try       = ["yay", "paru", "pacman"]
install   = "--noconfirm -S --needed {pkg}"
uninstall = "--noconfirm -Rns {pkg}"
check     = "{try} -Q {pkg}"
info      = "{try} -Qi {pkg} 2>/dev/null || {try} -Si {pkg}"
list      = "{try} -Qe | awk '{print $1}'"

[[managers]]
id        = "system"
try       = ["brew"]
install   = "install {pkg}"
uninstall = "uninstall {pkg}"
check     = "brew list --formula {pkg}"
info      = "brew info {pkg}"
list      = "{try} list --formula"

[[managers]]
id        = "flatpak"
try       = ["flatpak"]
install   = "install -y flathub {pkg}"
uninstall = "uninstall -y {pkg}"
check     = "flatpak info {pkg}"
info      = "flatpak info {pkg} 2>/dev/null || flatpak remote-info flathub {pkg}"
list      = "{try} list --app --columns=application"

[[managers]]
id        = "snap"
try       = ["snap"]
install   = "install {pkg}"
uninstall = "remove {pkg}"
check     = "snap list {pkg}"
info      = "snap info {pkg}"
list      = "{try} list 2>/dev/null | awk 'NR>1 {print $1}'"

# ── Python ────────────────────────────────────────────────────────────────────
# pack.toml key: python = "package-name"
# uv is tried first; falls back to pipx if uv is not on PATH.

[[managers]]
id        = "python"
try       = ["uv"]
install   = "tool install {pkg}"
uninstall = "tool uninstall {pkg}"
check     = "uv tool list | grep -E \"^{pkg}[[:space:]]\""
info      = "uv tool list | grep -E \"^{pkg}[[:space:]]\" 2>/dev/null || pip show {pkg}"
list      = "uv tool list 2>/dev/null | grep -E '^[a-z]' | awk '{print $1}'"

[[managers]]
id        = "python"
try       = ["pipx"]
install   = "install {pkg}"
uninstall = "uninstall {pkg}"
check     = "pipx list | grep -E \"package {pkg}[[:space:]]\""
info      = "pipx list | grep -E \"package {pkg}[[:space:]]\" 2>/dev/null || pip show {pkg}"
list      = "pipx list 2>/dev/null | grep 'package ' | awk '{print $2}'"

# ── Node ──────────────────────────────────────────────────────────────────────
# pack.toml key: node = "package-name"
# bun → pnpm → yarn → npm, first found on PATH wins.

[[managers]]
id        = "node"
try       = ["bun"]
install   = "add -g {pkg}"
uninstall = "remove -g {pkg}"
check     = "bun pm ls -g 2>/dev/null | grep -q \" {pkg}@\""
info      = "bun pm ls -g 2>/dev/null | grep \" {pkg}@\" || npm view {pkg}"
list      = "bun pm ls -g 2>/dev/null | awk -F@ '/[├└]/{gsub(/[^a-zA-Z0-9._-]/, \"\", $1); if($1 != \"\") print $1}'"

[[managers]]
id        = "node"
try       = ["pnpm"]
install   = "add -g {pkg}"
uninstall = "remove -g {pkg}"
check     = "pnpm list -g --depth=0 {pkg}"
info      = "pnpm list -g 2>/dev/null | grep {pkg} || pnpm view {pkg}"
list      = "pnpm list -g --depth=0 --parseable 2>/dev/null | tail -n +2 | xargs -I{} basename {}"

[[managers]]
id        = "node"
try       = ["yarn"]
install   = "global add {pkg}"
uninstall = "global remove {pkg}"
check     = "yarn global list 2>/dev/null | grep -q \" {pkg}@\""
info      = "yarn global list 2>/dev/null | grep \" {pkg}@\" || yarn info {pkg}"
list      = "yarn global list --depth=0 2>/dev/null | grep info | sed \"s/.*\\\"//; s/@.*//\""

[[managers]]
id        = "node"
try       = ["npm"]
install   = "install -g {pkg}"
uninstall = "uninstall -g {pkg}"
check     = "npm list -g --depth=0 {pkg}"
info      = "npm list -g --depth=0 {pkg} 2>/dev/null | grep {pkg} || npm view {pkg}"
list      = "npm list -g --depth=0 --parseable 2>/dev/null | tail -n +2 | xargs -I{} basename {}"

# ── Rust ──────────────────────────────────────────────────────────────────────
# pack.toml key: rust = "crate-name"

[[managers]]
id        = "rust"
try       = ["cargo"]
install   = "install {pkg}"
uninstall = "uninstall {pkg}"
check     = "cargo install --list | grep -q \"^{pkg} \""
info      = "cargo install --list | grep -A1 \"^{pkg} \" || cargo search --limit 1 {pkg}"
list      = "cargo install --list 2>/dev/null | grep -E '^[a-zA-Z]' | awk '{print $1}'"

# ── Ruby ──────────────────────────────────────────────────────────────────────
# pack.toml key: ruby = "gem-name"

[[managers]]
id        = "ruby"
try       = ["gem"]
install   = "install {pkg}"
uninstall = "uninstall -x {pkg}"
check     = "gem list -i \"^{pkg}$\""
info      = "gem list --local {pkg} | grep -q \"^{pkg}\" && gem info {pkg} || gem info -r {pkg}"
list      = "gem list --local 2>/dev/null | awk '{print $1}'"
