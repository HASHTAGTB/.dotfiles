#!/usr/bin/env bash
# nvim-switch.sh — interactively switch between Neovim distros
# Distros are stored as nvim.<distroname> in each config dir.
# The active distro lives in the plain `nvim` folder.
# A state file next to this script tracks which distro is active.

set -euo pipefail

# ── Paths ──────────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_FILE="$SCRIPT_DIR/.nvim-distro-state"

DIRS=(
  "$HOME/.config"
  "$HOME/.local/share"
  "$HOME/.local/state"
  "$HOME/.cache"
)

# ── Colours ────────────────────────────────────────────────────────────────
BOLD='\033[1m'
GREEN='\033[1;32m'
CYAN='\033[1;36m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
DIM='\033[2m'
RESET='\033[0m'

# ── Helpers ────────────────────────────────────────────────────────────────
die() { echo -e "${RED}Error:${RESET} $*" >&2; exit 1; }

# Read the currently active distro from the state file
get_active() {
  [[ -f "$STATE_FILE" ]] && cat "$STATE_FILE" || echo ""
}

# Persist the active distro name
set_active() {
  echo "$1" > "$STATE_FILE"
}

# Discover available distros by inspecting ~/.config/nvim.<name> folders.
# Also accepts nvim.bak as the legacy name (treated as distro "bak").
get_distros() {
  local distros=()
  for entry in "$HOME/.config"/nvim.*; do
    [[ -d "$entry" ]] || continue
    local name="${entry##*.}"          # everything after the last dot
    [[ -n "$name" ]] && distros+=("$name")
  done
  printf '%s\n' "${distros[@]}"
}

# Swap active nvim ↔ a named distro across all four dirs
do_switch() {
  local target="$1"
  local active
  active="$(get_active)"

  echo -e "\n${BOLD}Switching to:${RESET} ${GREEN}${target}${RESET}"
  [[ -n "$active" ]] && echo -e "${DIM}  (was: ${active})${RESET}"

  for base in "${DIRS[@]}"; do
    local live="$base/nvim"
    local target_dir="$base/nvim.$target"
    local backup_dir="$base/nvim.$active"

    # Target distro folder must exist (at least in ~/.config)
    if [[ "$base" == "$HOME/.config" && ! -d "$target_dir" ]]; then
      die "Target distro folder not found: $target_dir"
    fi

    # Step 1 – park current live → tmp
    if [[ -d "$live" ]]; then
      mv "$live" "${live}.tmp_switch"
    fi

    # Step 2 – bring target into place
    if [[ -d "$target_dir" ]]; then
      mv "$target_dir" "$live"
    fi

    # Step 3 – move old live to its named backup (only if we had one active)
    if [[ -n "$active" && -d "${live}.tmp_switch" ]]; then
      mv "${live}.tmp_switch" "$backup_dir"
    elif [[ -d "${live}.tmp_switch" ]]; then
      # No known name for the old config — keep it as nvim.unknown
      mv "${live}.tmp_switch" "$base/nvim.unknown"
      echo -e "${YELLOW}  Warning:${RESET} no active distro name known; old $base/nvim saved as nvim.unknown"
    fi
  done

  set_active "$target"
  echo -e "\n${GREEN}✓ Active distro is now:${RESET} ${BOLD}${target}${RESET}\n"
}

# ── Migration hint ─────────────────────────────────────────────────────────
# If the user still has nvim.bak from the original setup, remind them to
# rename it to a proper distro name (e.g. nvim.lazyvim).
check_legacy_bak() {
  if [[ -d "$HOME/.config/nvim.bak" ]]; then
    echo -e "${YELLOW}Note:${RESET} Found ${BOLD}nvim.bak${RESET} — this is treated as distro ${BOLD}\"bak\"${RESET}."
    echo -e "  Rename it to a friendlier name with:"
    echo -e "  ${DIM}for d in ~/.config ~/.local/share ~/.local/state ~/.cache; do"
    echo -e "    mv \"\$d/nvim.bak\" \"\$d/nvim.lazyvim\" 2>/dev/null; done${RESET}\n"
  fi
}

# ── Interactive menu ───────────────────────────────────────────────────────
main() {
  echo -e "\n${BOLD}${CYAN}── Neovim Distro Switcher ──${RESET}"

  check_legacy_bak

  local active
  active="$(get_active)"

  # Auto-detect distros from nvim.<name> folders
  mapfile -t distros < <(get_distros)

  if [[ ${#distros[@]} -eq 0 ]]; then
    die "No distro folders found. Create at least one ~/.config/nvim.<name> directory."
  fi

  # ── Display menu ──
  echo -e "${DIM}Active distro: ${RESET}${active:-${YELLOW}(unknown)${RESET}}\n"
  echo -e "Available distros:\n"

  local i=1
  for d in "${distros[@]}"; do
    if [[ "$d" == "$active" ]]; then
      echo -e "  ${GREEN}${i})${RESET} ${BOLD}${d}${RESET}  ${GREEN}← active${RESET}"
    else
      echo -e "  ${CYAN}${i})${RESET} ${d}"
    fi
    (( i++ ))
  done

  echo -e "  ${DIM}q) Quit${RESET}\n"

  # ── Prompt ──
  while true; do
    read -rp "Select distro [1-${#distros[@]}/q]: " choice

    [[ "$choice" =~ ^[qQ]$ ]] && { echo "Bye."; exit 0; }

    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#distros[@]} )); then
      local selected="${distros[$((choice - 1))]}"

      if [[ "$selected" == "$active" ]]; then
        echo -e "${YELLOW}Already using ${BOLD}${selected}${RESET}${YELLOW}. Nothing to do.${RESET}"
        exit 0
      fi

      do_switch "$selected"
      exit 0
    fi

    echo -e "${RED}Invalid choice.${RESET} Enter a number between 1 and ${#distros[@]}, or q."
  done
}

main "$@"
