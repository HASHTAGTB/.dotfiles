#!/usr/bin/env bash
set -euo pipefail
DIR="${XDG_CONFIG_HOME:-$HOME}/dotfiles/packages"
mkdir -p "$DIR"

pacman -Qqen  > "$DIR/pacman.txt"
pacman -Qqem  > "$DIR/aur.txt"
cargo install --list | awk '/^[a-z]/{print $1}' > "$DIR/cargo.txt"
uv tool list  | awk 'NR>0{print $1}' > "$DIR/uv.txt"
# command -v npm    &>/dev/null && npm list -g --depth=0 --json \
#   | jq -r '.dependencies | keys[]' > "$DIR/npm.txt"
# command -v flatpak &>/dev/null && flatpak list --app --columns=application > "$DIR/flatpak.txt"
# command -v pipx   &>/dev/null && pipx list --json \
#   | jq -r '.venvs | keys[]' > "$DIR/pipx.txt"

echo "Saved to $DIR"
