#!/usr/bin/env bash
set -euo pipefail

WALLPAPER_DIR="${1:-$HOME/img/wallpapers}"
ACTIVE_LINK="$WALLPAPER_DIR/active"

ACTIVE_PACK=""
if [ -L "$ACTIVE_LINK" ]; then
    ACTIVE_PACK=$(basename "$(readlink "$ACTIVE_LINK")")
fi

PACKS=()
shopt -s nullglob
for dir in "$WALLPAPER_DIR"/*; do
    if [[ -d "$dir" && ! -L "$dir" ]]; then
        PACKS+=( "$(basename "$dir")" )
    fi
done

[[ ${#PACKS[@]} -eq 0 ]] && echo "No wallpaper packs found." && exit 1

NEXT_INDEX=0
for i in "${!PACKS[@]}"; do
    if [[ "${PACKS[$i]}" == "$ACTIVE_PACK" ]]; then
        NEXT_INDEX=$(( (i + 1) % ${#PACKS[@]} ))
        break
    fi
done

NEXT_PACK="${PACKS[$NEXT_INDEX]}"
ln -sfn "$WALLPAPER_DIR/$NEXT_PACK" "$ACTIVE_LINK"

echo "Switched wallpaper pack to: $NEXT_PACK"

exec "$(dirname $0)/random-wallpaper"
